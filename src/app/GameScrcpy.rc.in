#include <winver.h>

IDI_ICON1 ICON "@GS_APP_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @GameScrcpy_VERSION_MAJOR@,@GameScrcpy_VERSION_MINOR@,@GameScrcpy_VERSION_PATCH@,0
 PRODUCTVERSION @GameScrcpy_VERSION_MAJOR@,@GameScrcpy_VERSION_MINOR@,@GameScrcpy_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GameScrcpy"
            VALUE "FileDescription", "GameScrcpy"
            VALUE "FileVersion", "@GameScrcpy_VERSION@"
            VALUE "InternalName", "GameScrcpy"
            VALUE "LegalCopyright", "Licensed under the Apache License 2.0"
            VALUE "OriginalFilename", "GameScrcpy.exe"
            VALUE "ProductName", "GameScrcpy"
            VALUE "ProductVersion", "@GameScrcpy_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
