{
  "name": "touch",
  "steps": [
    {"do": "touch.open", "method": "recorder", "expect": {"opened": true}},
    {"do": "touch.frame", "rotation": 1, "contacts": [{"id": 0, "action": "down", "x": 0.25, "y": 0.5}],
     "expect": {"ok": true,
                "sent": [{"id": 0, "action": "down", "x": 0.25, "y": 0.5, "naturalX": 0.5, "naturalY": 0.25, "pressure": 1}]}},
    {"do": "touch.frame", "rotation": 1, "contacts": [{"id": 0, "action": "up", "x": 0.25, "y": 0.5}],
     "expect": {"sent": [{"action": "up", "pressure": 0}]}},
    {"do": "touch.key", "key": "back"},
    {"do": "touch.text", "text": "hi"},
    {"do": "call", "node": "touches",
     "expect": {"value": {"device": "mock-phone",
                          "options": {"phone": "mock-phone", "device": null, "touchBox": null,
                                      "settings": {"port": "COM1", "speed": 115200}, "deviceSettings": {}},
                          "seen": ["open", [0, 0, 0.25, 0.5, 0.5, 0.25, 1], [0, 2, 0.25, 0.5, 0.5, 0.25, 1], ["key", 4, 1],
                                   ["text", "hi"]]}}},
    {"do": "touch.frame", "contacts": [{"id": 1, "action": "down", "x": 0.75, "y": 0.75}]},
    {"do": "touch.frame", "contacts": [{"id": 1, "action": "cancel", "x": 0.75, "y": 0.75}],
     "expect": {"sent": [{"id": 1, "action": "cancel", "pressure": 0}]}},
    {"do": "touch.mouse", "buttons": 1, "dx": 5, "dy": -3},
    {"do": "touch.pad", "buttons": 1, "leftX": 1000},
    {"do": "touch.close"},
    {"do": "call", "node": "touches",
     "expect": {"value": {"seen": [[1, 0, 0.75, 0.75, 0.75, 0.75, 0], [1, 3, 0.75, 0.75, 0.75, 0.75, 0],
                                   ["mouse", 1, 5, -3, 0], ["pad", 1, 8, 1000, 0, 0, 0, 0, 0], "close"]}}}
  ]
}
