{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts", "**/*.mts"],
  "exclude": ["node_modules"]
}
