foreach(input IN ITEMS GS SOURCE ID OUT)
    if("${${input}}" STREQUAL "")
        message(FATAL_ERROR "PackSample.cmake needs -D${input}=<value>")
    endif()
endforeach()
file(TO_CMAKE_PATH "${GS}" program)
file(TO_CMAKE_PATH "${SOURCE}" source)
file(TO_CMAKE_PATH "${OUT}" package)
if(NOT EXISTS "${source}/manifest.json")
    message(FATAL_ERROR "${source} holds no manifest.json: build the sample first")
endif()
get_filename_component(folder "${package}" DIRECTORY)
set(staging "${package}.staging")
file(REMOVE_RECURSE "${staging}")
file(MAKE_DIRECTORY "${folder}")
file(COPY "${source}/" DESTINATION "${staging}")
file(READ "${staging}/manifest.json" manifest)
string(JSON manifest ERROR_VARIABLE problem SET "${manifest}" id "\"${ID}\"")
if(problem)
    file(REMOVE_RECURSE "${staging}")
    message(FATAL_ERROR "the manifest in ${source} cannot take the id ${ID}: ${problem}")
endif()
file(WRITE "${staging}/manifest.json" "${manifest}")
execute_process(COMMAND "${program}" pack "${staging}" -o "${package}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
file(REMOVE_RECURSE "${staging}")
string(STRIP "${output}" output)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "${program} pack ${staging} failed (${result}):\n${output}")
endif()
message(STATUS "${output}")
