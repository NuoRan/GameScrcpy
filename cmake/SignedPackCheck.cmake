foreach(input IN ITEMS GS SOURCE WORK)
    if("${${input}}" STREQUAL "")
        message(FATAL_ERROR "SignedPackCheck.cmake needs -D${input}=<value>")
    endif()
endforeach()
file(TO_CMAKE_PATH "${GS}" program)
file(TO_CMAKE_PATH "${SOURCE}" source)
file(TO_CMAKE_PATH "${WORK}" work)
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")

function(gs_run name)
    execute_process(COMMAND "${program}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE problem)
    set(${name}_result "${result}" PARENT_SCOPE)
    set(${name}_output "${output}" PARENT_SCOPE)
    set(${name}_problem "${problem}" PARENT_SCOPE)
endfunction()

gs_run(keygen ext keygen "${work}/author.key" --json)
if(NOT keygen_result EQUAL 0)
    message(FATAL_ERROR "gs ext keygen failed (${keygen_result}):\n${keygen_output}${keygen_problem}")
endif()
string(JSON author_key GET "${keygen_output}" authorKey)
string(JSON key_id GET "${keygen_output}" keyId)
if(NOT EXISTS "${work}/author.pub")
    message(FATAL_ERROR "gs ext keygen wrote no public key next to ${work}/author.key")
endif()

file(COPY "${source}/" DESTINATION "${work}/folder")
file(READ "${work}/folder/manifest.json" manifest)
string(JSON manifest SET "${manifest}" authorKey "\"${author_key}\"")
file(WRITE "${work}/folder/manifest.json" "${manifest}")

gs_run(pack pack "${work}/folder" --sign "${work}/author.key" -o "${work}/signed.gsext")
if(NOT pack_result EQUAL 0)
    message(FATAL_ERROR "gs pack --sign failed (${pack_result}):\n${pack_output}${pack_problem}")
endif()
if(NOT pack_output MATCHES "signed with key ${key_id}")
    message(FATAL_ERROR "gs pack --sign did not name the key it signed with:\n${pack_output}")
endif()

gs_run(valid validate "${work}/signed.gsext" --json)
if(NOT valid_result EQUAL 0)
    message(FATAL_ERROR "gs validate refused the signed package (${valid_result}):\n${valid_output}${valid_problem}")
endif()
string(JSON state GET "${valid_output}" signature state)
string(JSON signer GET "${valid_output}" signature keyId)
if(NOT state STREQUAL "valid" OR NOT signer STREQUAL key_id)
    message(FATAL_ERROR "gs validate did not find the signature of ${key_id}:\n${valid_output}")
endif()

gs_run(other ext keygen "${work}/other.key")
if(NOT other_result EQUAL 0)
    message(FATAL_ERROR "gs ext keygen failed for a second key (${other_result}):\n${other_problem}")
endif()
gs_run(mismatch pack "${work}/folder" --sign "${work}/other.key" -o "${work}/other.gsext")
if(mismatch_result EQUAL 0 OR NOT mismatch_output MATCHES "signing-key-mismatch at [$][.]authorKey")
    message(FATAL_ERROR "gs pack --sign took a key that authorKey does not name:\n${mismatch_output}")
endif()

gs_run(again ext keygen "${work}/author.key")
if(again_result EQUAL 0)
    message(FATAL_ERROR "gs ext keygen replaced an existing secret key without --force")
endif()

file(ARCHIVE_EXTRACT INPUT "${work}/signed.gsext" DESTINATION "${work}/unpacked")
file(APPEND "${work}/unpacked/manifest.json" " ")
gs_run(tampered validate "${work}/unpacked")
if(tampered_result EQUAL 0 OR NOT tampered_output MATCHES "signature-invalid")
    message(FATAL_ERROR "gs validate did not notice a file changed after signing:\n${tampered_output}")
endif()
message(STATUS "signed with ${key_id}; another key, an existing key file and a changed file were caught")
