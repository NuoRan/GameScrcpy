file(REMOVE_RECURSE "${DESTINATION}")
file(GLOB folders LIST_DIRECTORIES true "${SOURCE}/*")
string(REPLACE "|" ";" extra_folders "${EXTRA}")
list(APPEND folders ${extra_folders})
foreach(folder IN LISTS folders)
    if(NOT EXISTS "${folder}/manifest.json" OR EXISTS "${folder}/CMakeLists.txt")
        continue()
    endif()
    file(READ "${folder}/manifest.json" manifest)
    string(JSON id GET "${manifest}" id)
    string(JSON version GET "${manifest}" version)
    file(COPY "${folder}/" DESTINATION "${DESTINATION}/${id}/${version}")
endforeach()
