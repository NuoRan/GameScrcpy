{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_C_FLAGS_INIT": "/utf-8",
        "CMAKE_CXX_FLAGS_INIT": "/utf-8",
        "CMAKE_PREFIX_PATH": "$env{GS_QT_DIR}"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC x64 Debug",
      "inherits": "msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC x64 Release (LTO)",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "msvc-asan",
      "displayName": "MSVC x64 Debug + AddressSanitizer",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GS_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "core-only",
      "displayName": "Core libraries and tests only (no Qt)",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GS_BUILD_APP": "OFF"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (Release without LTO, warnings as errors)",
      "inherits": "msvc-release",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "GS_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc-debug" },
    { "name": "msvc-release", "configurePreset": "msvc-release" },
    { "name": "msvc-asan", "configurePreset": "msvc-asan" },
    { "name": "core-only", "configurePreset": "core-only" },
    { "name": "ci", "configurePreset": "ci" }
  ],
  "testPresets": [
    { "name": "msvc-debug", "configurePreset": "msvc-debug", "output": { "outputOnFailure": true } },
    { "name": "msvc-release", "configurePreset": "msvc-release", "output": { "outputOnFailure": true } },
    { "name": "msvc-asan", "configurePreset": "msvc-asan", "output": { "outputOnFailure": true } },
    { "name": "core-only", "configurePreset": "core-only", "output": { "outputOnFailure": true } },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true },
      "filter": {
        "exclude": {
          "name": "^(gs_app_smoke|gs_app_smoke_mirror|gs_video_render_probe|gs_video_render_sharpness|gs_video_render_filters|gs_video_render_shared|gs_endurance_smoke|gs_session_device_tests|gs_adb_device_tests|gs_direct_interop_tests)$"
        }
      },
      "execution": { "repeat": { "mode": "until-pass", "count": 2 } }
    }
  ],
  "workflowPresets": [
    {
      "name": "msvc-debug",
      "steps": [
        { "type": "configure", "name": "msvc-debug" },
        { "type": "build", "name": "msvc-debug" },
        { "type": "test", "name": "msvc-debug" }
      ]
    },
    {
      "name": "msvc-release",
      "steps": [
        { "type": "configure", "name": "msvc-release" },
        { "type": "build", "name": "msvc-release" },
        { "type": "test", "name": "msvc-release" }
      ]
    },
    {
      "name": "msvc-asan",
      "steps": [
        { "type": "configure", "name": "msvc-asan" },
        { "type": "build", "name": "msvc-asan" },
        { "type": "test", "name": "msvc-asan" }
      ]
    },
    {
      "name": "core-only",
      "steps": [
        { "type": "configure", "name": "core-only" },
        { "type": "build", "name": "core-only" },
        { "type": "test", "name": "core-only" }
      ]
    },
    {
      "name": "ci",
      "steps": [
        { "type": "configure", "name": "ci" },
        { "type": "build", "name": "ci" },
        { "type": "test", "name": "ci" }
      ]
    }
  ]
}
